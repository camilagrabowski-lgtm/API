
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Usuario {
  id    Int    @id @default(autoincrement())
  nome  String
  email String @unique
  senha String
}

model Personagem {
  id         Int     @id @default(autoincrement())
  nome       String
  aldeia     String
  cla        String?
  habilidade String
  bijuu      String?
}
